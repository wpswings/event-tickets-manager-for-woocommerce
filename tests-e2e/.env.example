# Copy this file to .env and adjust if your local site differs.
BASE_URL=http://localhost:10066
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin

# A product that will be created/deleted by the suite. Change if it collides
# with something real on your site.
TEST_EVENT_PRODUCT_PREFIX=E2E Test Event

# Version the compatibility spec expects on the Plugins screen and in asset ?ver= strings.
EXPECTED_PLUGIN_VERSION=1.6.1
